# ===================================================================
#  Copy this file to `.env` and adjust. `.env` is gitignored.
#
#  Vite only exposes variables prefixed with VITE_ to the browser bundle.
#  That prefix is a safety feature, not a naming convention: it stops a
#  server secret in your shell environment from being accidentally
#  compiled into public JavaScript.
#
#  Corollary: NEVER put a secret in a VITE_ variable. Anything here ends
#  up readable in the browser's Sources tab. Secrets belong on the
#  Spring Boot side only.
# ===================================================================

# Where the Spring Boot API lives, including the /api/v1 prefix.
# Local development:
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Production example (set this in your hosting dashboard, not in git):
# VITE_API_BASE_URL=https://movemate-api.up.railway.app/api/v1

# Shown in the navbar and footer so the number is in one place.
VITE_CONTACT_PHONE=+918999115935
VITE_CONTACT_EMAIL=hello@movemate.in
