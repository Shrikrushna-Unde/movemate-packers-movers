<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- modelVersion is always 4.0.0 for Maven 2/3/4 POMs. It describes the POM format, not our app. -->
    <modelVersion>4.0.0</modelVersion>

    <!--
      The parent POM. spring-boot-starter-parent gives us:
        1. Dependency management (a curated BOM) so we never write <version> for Spring libraries.
           Spring Boot 3.3.4 already knows which Hibernate / Jackson / MySQL driver versions work together.
        2. Sensible plugin defaults (compiler, surefire, resource filtering, repackaging into a fat JAR).
      Upgrading Spring Boot = changing this one number.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <!-- Maven coordinates: groupId:artifactId:version uniquely identify this artifact. -->
    <groupId>com.movemate</groupId>
    <artifactId>movemate-api</artifactId>
    <version>1.0.0</version>
    <name>movemate-api</name>
    <description>REST API for MoveMate Packers and Movers</description>

    <properties>
        <!-- Java 17 is the current LTS baseline required by Spring Boot 3.x. -->
        <java.version>17</java.version>
        <!-- jjwt is NOT managed by the Spring Boot BOM, so we pin it ourselves. -->
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.6.0</springdoc.version>
    </properties>

    <dependencies>

        <!--
          spring-boot-starter-web pulls in Spring MVC + embedded Tomcat + Jackson.
          This is what turns the project into an HTTP server that speaks JSON.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          spring-boot-starter-data-jpa pulls in Hibernate (the JPA implementation),
          Spring Data JPA repositories, and HikariCP (the connection pool).
          It is why we can write `interface BookingRepository extends JpaRepository<...>`
          and get SQL generated for us.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
          Bean Validation (Jakarta Validation + Hibernate Validator).
          Gives us @NotBlank / @Email / @Min on DTOs so invalid requests are rejected
          before a single line of business logic runs.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          Spring Security: authentication + authorisation filter chain,
          BCryptPasswordEncoder, and the @PreAuthorize method security we use for admin routes.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
          Actuator exposes /actuator/health. Render and Railway ping a health URL to decide
          whether a deploy succeeded, so this is not optional in production.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          Flyway = versioned SQL migrations. The database schema lives in
          src/main/resources/db/migration as numbered .sql files, checked into git.
          flyway-mysql is a separate artifact in Flyway 10.x and is required for MySQL support.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- The MySQL JDBC driver. runtime scope: needed to run, not to compile. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          H2, an embedded Java database, used ONLY by the `dev` profile.

          Why it is here: it lets the whole application start with zero installation - no MySQL
          server, no Docker, no cloud account. That matters for onboarding (someone cloning the
          repo can run it in one command) and it is the standard Spring Boot answer for local
          development and integration tests.

          The honest tradeoff, which belongs in any interview answer about this: dev then runs
          on a different engine from production. H2 is close to MySQL but not identical, so
          anything vendor-specific must still be verified against real MySQL before shipping.
          That is exactly why the Flyway migrations remain MySQL-authored and are NOT run
          against H2 - see application-dev.properties.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          JJWT, split into three artifacts by design:
            api  - the interfaces we code against
            impl - the runtime implementation (runtime scope so it cannot leak into our imports)
            jackson - JSON serialisation of the JWT claims
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
          springdoc generates OpenAPI 3 docs from our controllers and serves Swagger UI
          at /swagger-ui.html. Interviewers love a live API explorer.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- JUnit 5, Mockito, AssertJ and MockMvc, all in one test starter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              The Boot plugin repackages target/movemate-api-1.0.0.jar into an executable
              fat JAR (all dependencies + an embedded launcher) so `java -jar` just works.
              That single JAR is what our Docker image runs.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
